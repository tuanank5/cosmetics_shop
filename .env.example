# Mẫu: cần đưa vào Environment Variables trong IntelliJ hoặc PowerShell.
# Spring Boot KHÔNG tự nạp file .env.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mariadb://localhost:3306/beautyshop
DB_USER=beautyshop
DB_PASSWORD=
# Production: cấu hình secret ngoài Git, HTTPS.
# Những biến dưới đây chỉ cần khi task tương ứng được triển khai.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=https://example-domain.example/payment/momo/return
MOMO_IPN_URL=https://example-domain.example/payment/momo/ipn
MOMO_ENABLED=false
# Values: disabled | mock | sandbox. Mock chi duoc dung dev/test, khong thanh toan that.
MOMO_MODE=disabled
AI_ENABLED=false
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=bge-m3

# OAuth2 tùy chọn. Điền đủ một cặp để bật nhà cung cấp tương ứng.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Redis và SMTP phục vụ OTP, xác thực lại và khôi phục mật khẩu.
AUTH_PUBLIC_URL=http://localhost:8080
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
