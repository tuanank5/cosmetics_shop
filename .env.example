# Mẫu: cần đưa vào Environment Variables trong IntelliJ hoặc PowerShell.
# Spring Boot KHÔNG tự nạp file .env.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mariadb://localhost:3306/beautyshop
DB_USER=beautyshop
DB_PASSWORD=
# OTP P04: local Redis + Mailpit (giao diện hộp thư http://127.0.0.1:8025).
OTP_REDIS_HOST=127.0.0.1
OTP_REDIS_PORT=6379
OTP_MAIL_HOST=127.0.0.1
OTP_MAIL_PORT=1025
OTP_MAIL_FROM=no-reply@beautyshop.test
# Google/GitHub tùy chọn. Thêm oauth2-google,oauth2-github vào SPRING_PROFILES_ACTIVE để bật.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Production: cấp OTP_REDIS_PASSWORD, OTP_MAIL_USERNAME, OTP_MAIL_PASSWORD qua secret store.
# Dùng cổng SMTP hỗ trợ STARTTLS (mặc định 587) và địa chỉ OTP_MAIL_FROM đã được xác minh.
# Production: cấu hình secret ngoài Git, HTTPS.
# Những biến dưới đây chỉ cần khi task tương ứng được triển khai.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=https://example-domain.example/payment/momo/return
MOMO_IPN_URL=https://example-domain.example/payment/momo/ipn
MOMO_ENABLED=false
# Values: disabled | mock | sandbox. Mock chi duoc dung dev/test, khong thanh toan that.
MOMO_MODE=disabled
AI_ENABLED=false
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=bge-m3
# P23: MongoDB lưu đánh giá. Local không cần mật khẩu khi chỉ bind 127.0.0.1; production dùng URI có user/password từ secret store.
MONGODB_URI=mongodb://127.0.0.1:27017/beautyshop_demo
# mongo (mặc định) | mariadb (dự phòng, dùng bảng danh_gia cũ)
REVIEWS_STORE=mongo
REVIEWS_MIGRATE_FROM_MARIADB=false
