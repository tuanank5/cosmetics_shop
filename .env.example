# Mẫu: cần đưa vào Environment Variables trong IntelliJ hoặc PowerShell.
# Spring Boot KHÔNG tự nạp file .env.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mariadb://localhost:3306/beautyshop
DB_USER=beautyshop
DB_PASSWORD=
# Production: cấu hình secret ngoài Git, HTTPS.
# Những biến dưới đây chỉ cần khi task tương ứng được triển khai.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=https://example-domain.example/payment/momo/return
MOMO_IPN_URL=https://example-domain.example/payment/momo/ipn
MOMO_ENABLED=false
# Values: disabled | mock | sandbox. Mock chi duoc dung dev/test, khong thanh toan that.
MOMO_MODE=disabled
AI_ENABLED=false
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=bge-m3
